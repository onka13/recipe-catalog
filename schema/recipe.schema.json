{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "RECIPE.md front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "language",
    "stack",
    "category",
    "standardType",
    "order",
    "verify"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "defs.schema.json#/$defs/semver"
    },
    "language": {
      "$ref": "defs.schema.json#/$defs/language"
    },
    "stack": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "category": {
      "$ref": "defs.schema.json#/$defs/id",
      "description": "One of CATEGORIES.md"
    },
    "standardType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The capability the recipe provides (logging, networking-rest, delivery-scripts, ..., or custom)"
    },
    "interfacePort": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "$ref": "defs.schema.json#/$defs/names"
    },
    "platformPermissions": {
      "$ref": "defs.schema.json#/$defs/names"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "secret"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "default": {
            "type": "string"
          },
          "secret": {
            "type": "boolean"
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "dev"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "dev": {
            "type": "boolean"
          }
        }
      }
    },
    "onlyIfMissing": {
      "$ref": "defs.schema.json#/$defs/names",
      "description": "Paths under files/ written only when the project does not have them"
    },
    "verify": {
      "$ref": "defs.schema.json#/$defs/commands",
      "type": "array",
      "minItems": 1
    }
  }
}

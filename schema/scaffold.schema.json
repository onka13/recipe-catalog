{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scaffold.schema.json",
  "title": "SCAFFOLD.md front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "language", "stack", "markerFile", "requiredTools", "commands", "verify", "mandatoryRecipes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "defs.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "defs.schema.json#/$defs/semver" },
    "language": { "$ref": "defs.schema.json#/$defs/language" },
    "stack": { "$ref": "defs.schema.json#/$defs/id" },
    "markerFile": { "type": "string", "minLength": 1, "description": "Must exist after the scaffold; shows that a folder is already scaffolded" },
    "requiredTools": { "$ref": "defs.schema.json#/$defs/names" },
    "commands": { "$ref": "defs.schema.json#/$defs/commands", "description": "Run in the empty tier folder before files/ is written" },
    "verify": { "$ref": "defs.schema.json#/$defs/commands", "type": "array", "minItems": 1 },
    "mandatoryRecipes": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/id" }, "minItems": 1, "uniqueItems": true, "description": "Applied in this order; the first is the stack's delivery-scripts recipe" }
  }
}

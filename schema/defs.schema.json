{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80, "description": "Kebab-case id, equal to the folder name" },
    "language": { "type": "string", "pattern": "^[a-z][a-z0-9+#-]*$", "description": "Primary language, lowercase (dart, typescript, python, ...)" },
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$" },
    "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}

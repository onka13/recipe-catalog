{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle.schema.json",
  "title": "Release bundle (release/catalog.json)",
  "description": "Every item of one tagged release, built from the Markdown items by `catalog build`. Consumers read this file instead of parsing Markdown.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "generator",
    "stacks",
    "scaffolds",
    "recipes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "$ref": "defs.schema.json#/$defs/semver"
    },
    "generator": {
      "type": "string"
    },
    "stacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stack"
      }
    },
    "scaffolds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scaffold"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "notes"
        ],
        "properties": {
          "version": {
            "$ref": "defs.schema.json#/$defs/semver"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "meta",
        "description"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "meta": {
          "$ref": "stack.schema.json"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "meta",
        "description",
        "changelog",
        "files",
        "contentHash"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "meta": {
          "$ref": "scaffold.schema.json"
        },
        "description": {
          "type": "string"
        },
        "changelog": {
          "$ref": "#/$defs/changelog"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "meta",
        "description",
        "instructions",
        "changelog",
        "files",
        "contentHash"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "meta": {
          "$ref": "recipe.schema.json"
        },
        "description": {
          "type": "string"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "instruction"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "conventions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "rule"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "changelog": {
          "$ref": "#/$defs/changelog"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
